APP_NAME=Pixelforge
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Use one provider key/signing secret per environment. Keep real values in ignored .env.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=

# Separate live-update hub keys; generate each with: openssl rand -base64 32
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DATABASE_URL is injected by Fairlead; set it explicitly on Dokploy.
# Separate test database credentials; never point tests at the application database.
TEST_DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# APP_URL is injected by Fairlead as https://pixelforge.fl.wb.
# Mail settings are derived from Fairlead's EMAIL_ADAPTER/SMTP_* variables.

VITE_APP_NAME="${APP_NAME}"
