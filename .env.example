APP_NAME=Pixelforge
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DATABASE_URL is injected by Fairlead; set it explicitly on Dokploy.
# Separate test database credentials; never point tests at the application database.
TEST_DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# APP_URL is injected by Fairlead as https://pixelforge.fl.wb.
# Mail settings are derived from Fairlead's EMAIL_ADAPTER/SMTP_* variables.

VITE_APP_NAME="${APP_NAME}"
