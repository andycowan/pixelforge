{
	auto_https off
}

:80 {
	root * /app/public

	@compressible not path /.well-known/mercure*
	encode @compressible zstd gzip

	mercure {
		issuer {$APP_URL} {
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY}
			}
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
			}
		}
		resource_identifier {$APP_URL}/.well-known/mercure
		transport local
	}

	php_server
}
