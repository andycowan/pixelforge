{
	admin off
	auto_https off
	persist_config off
}

http://:18081 {
	bind 127.0.0.1

	@webhook {
		method POST
		path /webhooks/pixelforge
	}

	handle @webhook {
		reverse_proxy https://127.0.0.1:443 {
			header_up Host pixelforge.fl.wb
			transport http {
				tls_server_name pixelforge.fl.wb
				tls_trust_pool file "{$FAIRLEAD_CA}"
			}

			@errors status 4xx 5xx
			handle_response @errors {
				respond "Webhook request rejected." {rp.status_code}
			}
		}
	}

	handle {
		respond 404
	}

	handle_errors {
		respond "Webhook gateway unavailable." {err.status_code}
	}
}
